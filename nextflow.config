// Nextflow flags
nextflow.enable.configProcessNamesValidation = false
nextflow.enable.moduleBinaries = true

// Unscoped options
cleanup   = false
workDir   = "nf-work"
outputDir = params.outdir

// Global default params, used in configs
params {
    // pipeline parameters
    help            = false
    datasets        = null
    no_infer_specie = false
    default_specie  = null
    wl_basedir      = "/nfs/cellgeni/STAR/whitelists"
    star_human_reference = "/nfs/cellgeni/STAR/human/2020A/index"
    star_mouse_reference = "/nfs/cellgeni/STAR/mouse/2020A/index"
    cr_human_reference = "/software/cellgen/cellgeni/refdata_10x/refdata-cellranger-arc-GRCh38-2020-A-2.0.0"
    cr_mouse_reference = "/software/cellgen/cellgeni/refdata_10x/refdata-cellranger-arc-mm10-2020-A-2.0.0"
    metaonly        = false
    starsolo        = false
    cellranger      = false

    // output parameters
    publish_mode        = 'link'
    outdir              = "results"
    monochrome_logs     = false
    trace_report_suffix = new java.util.Date().format( 'yyyy-MM-dd_HH-mm-ss')
}

executor {
    name           = 'lsf'
    perJobMemLimit = true
}
// Singularity environment parameters
singularity {
    enabled     = true
    autoMounts  = true
    cacheDir    = '/nfs/cellgeni/singularity/images/'
    runOptions  = '-B /lustre,/nfs'
    pullTimeout = '100m'
}

// Configure process parameters
process {
    errorStrategy = { task.exitStatus in ((130..145) + 104 + 175) && task.attempt < 3 || task.attempt == 1 ? 'retry' : 'ignore' }
    maxRetries    = 3
}

workflow {
    output {
        mode = 'link'
    }
}

// Capturing Nextflow log files into a 'reports' directory
timeline {
    enabled = true
    file    = "reports/execution_timeline_${params.trace_report_suffix}.html"
    overwrite = true
}
report {
    enabled = true
    file    = "reports/execution_report_${params.trace_report_suffix}.html"
    overwrite = true
}
trace {
    enabled = true
    file    = "reports/execution_trace_${params.trace_report_suffix}.txt"
    overwrite = true
    // The default field set omits exit and workdir, which are the two columns any
    // failure triage starts from — without them every question needs the console
    // log instead. tag is here too because process name alone cannot identify a task.
    fields  = 'task_id,hash,process,tag,name,status,exit,attempt,submit,duration,realtime,queue,cpus,memory,peak_rss,workdir'
}
dag {
    enabled = true
    file    = "reports/pipeline_dag_${params.trace_report_suffix}.html"
    overwrite = true
}
lineage {
    enabled = true
}

// Write a failure manifest when the run ends.
//
// errorStrategy is 'ignore' almost everywhere, so a failed task never reaches the
// pipeline's exit status and nothing lists what was lost. Batch 2 dropped two
// samples silently — their downloads gave up, the run carried on, and the only
// record was a line in the driver's console log. This turns that into a file.
//
// The collector reads the work dirs rather than the trace, so it does not depend
// on trace flush ordering, and --since scopes it to this run because nf-work
// accumulates across runs. Wrapped so that a problem here can never fail a run
// that otherwise succeeded.
workflow.onComplete = {
    try {
        // Plain java.io.File rather than Nextflow's file(): this closure runs once,
        // at the end of a run that may have taken a day, and must not be the thing
        // that breaks. Same reason everything here is inside the try.
        def script = new File("${projectDir}", "bin/failure_manifest.py")
        if (!script.exists()) {
            log.warn "Failure manifest skipped: ${script} not found"
            return
        }
        def manifest = "reports/failures_${params.trace_report_suffix}.tsv"
        def since = 0L
        try { since = (workflow.start.toInstant().toEpochMilli() / 1000L) as long }
        catch (Exception ignored) { since = 0L }
        def cmd = ["python3", script.toString(),
                   "--workdir", "${workflow.workDir}",
                   "--out", manifest,
                   "--since", "${since}"]
        def proc = cmd.execute(null, new File("${projectDir}"))
        def out = new StringBuilder()
        def err = new StringBuilder()
        proc.consumeProcessOutput(out, err)
        proc.waitForOrKill(120_000)
        if (out.length() > 0) {
            log.info "\n${out.toString().trim()}"
        }
        if (proc.exitValue() != 0) {
            log.warn "Failure manifest exited ${proc.exitValue()}: ${err.toString().trim()}"
        }
    }
    catch (Exception e) {
        log.warn "Failure manifest could not be written: ${e.message}"
    }
}

// Load module configurations
includeConfig 'configs/reprocess10x_sra2fastq.config'
includeConfig 'configs/reprocess10x_bam2fastq.config'
includeConfig 'configs/wget10x.config'
includeConfig 'configs/starsolo10x.config'
includeConfig 'configs/reprocess10x_mappingqc.config'
includeConfig 'configs/fetch10xmeta.config'
includeConfig 'configs/rename10xrun.config'
includeConfig 'configs/rename10xsample.config'
includeConfig 'configs/sra2fastq.config'
includeConfig 'configs/cellranger.config'

// Capture exit codes from upstream processes when piping
process.shell = ['/bin/bash', '-euo', 'pipefail']

manifest {
    name            = 'cellgeni/nf-reprocessing-public-10x'
    author          = "CellgenI Team"
    homePage        = 'https://github.com/cellgeni/nf-reprocessing-public-10x'
    description     = "Pipeline to load and process public 10x datasets"
    mainScript      = 'main.nf'
    nextflowVersion = '!>=26.04.1'
    version         = '26-135'
    license         = 'GPL-3.0'
}

outputDir = params.outdir