// Nextflow flags
nextflow.enable.configProcessNamesValidation = false
nextflow.enable.moduleBinaries = true

// Unscoped options
cleanup   = false
workDir   = "nf-work"
outputDir = params.outdir

// Global default params, used in configs
params {
    // pipeline parameters
    help            = false
    datasets        = null
    no_infer_specie = false
    default_specie  = null
    wl_basedir      = "/nfs/cellgeni/STAR/whitelists"
    star_human_reference = "/nfs/cellgeni/STAR/human/2020A/index"
    star_mouse_reference = "/nfs/cellgeni/STAR/mouse/2020A/index"
    cr_human_reference = "/software/cellgen/cellgeni/refdata_10x/refdata-cellranger-arc-GRCh38-2020-A-2.0.0"
    cr_mouse_reference = "/software/cellgen/cellgeni/refdata_10x/refdata-cellranger-arc-mm10-2020-A-2.0.0"
    metaonly        = false
    starsolo        = false
    cellranger      = false

    // output parameters
    publish_mode        = 'link'
    outdir              = "results"
    monochrome_logs     = false
    trace_report_suffix = new java.util.Date().format( 'yyyy-MM-dd_HH-mm-ss')
}

executor {
    name           = 'lsf'
    perJobMemLimit = true
}
// Singularity environment parameters
singularity {
    enabled     = true
    autoMounts  = true
    cacheDir    = '/nfs/cellgeni/singularity/images/'
    runOptions  = '-B /lustre,/nfs'
    pullTimeout = '100m'
}

// Configure process parameters
process {
    // EVERY task gets one retry, whatever its exit code; only the codes listed below
    // get further attempts. This is deliberate, and the `task.attempt == 1` clause is
    // load-bearing — do not "simplify" it away.
    //
    // Transient failures are not identifiable from an exit code. In batch 6 a STARsolo
    // task died at exit 1 on `R1 length (-2147483647) leaves no room for a UMI` — a
    // nonsense length read off a partly-staged FASTQ — and succeeded on its second
    // attempt. Exit 1 is not, and should not be, in the retriable set, so that sample
    // survived only because of this clause. Two more in the same batch, at exit 104
    // and 130, likewise cleared on one retry. Losing a good sample costs more than
    // rerunning a doomed one.
    //
    // The retry also guarantees the first attempt's work dir and stderr survive for
    // triage: a task is ignored only after failing twice.
    //
    // Retriable codes: 130-145 is the signal range (130 is in practice an LSF
    // TERM_MEMLIMIT kill, 139 a SIGSEGV — including STAR racing on the shared-memory
    // genome under `--genomeLoad LoadAndRemove`), 104 is STAR's own fatal error, 175
    // an LSF requeue. Add a code here when a transient class is identified, and record
    // it in docs/failure-modes.md in the same change. The set cannot be hoisted into a
    // named variable: Nextflow 26's strict config parser rejects `def` declarations in
    // a config file ("Variable declarations cannot be mixed with config statements").
    //
    // Written as `attempt == 1 || (code && attempt < 3)` rather than relying on `&&`
    // binding tighter than `||`. Same truth table, but the intent is on the page.
    errorStrategy = { task.attempt == 1 || (task.exitStatus in ((130..145) + 104 + 175) && task.attempt < 3) ? 'retry' : 'ignore' }
    maxRetries    = 3
}

workflow {
    output {
        mode = 'link'
    }
}

// Capturing Nextflow log files into a 'reports' directory
timeline {
    enabled = true
    file    = "reports/execution_timeline_${params.trace_report_suffix}.html"
    overwrite = true
}
report {
    enabled = true
    file    = "reports/execution_report_${params.trace_report_suffix}.html"
    overwrite = true
}
trace {
    enabled = true
    file    = "reports/execution_trace_${params.trace_report_suffix}.txt"
    overwrite = true
    // The default field set omits exit and workdir, which are the two columns any
    // failure triage starts from — without them every question needs the console
    // log instead. tag is here too because process name alone cannot identify a task.
    fields  = 'task_id,hash,process,tag,name,status,exit,attempt,submit,duration,realtime,queue,cpus,memory,peak_rss,workdir'
}
dag {
    enabled = true
    file    = "reports/pipeline_dag_${params.trace_report_suffix}.html"
    overwrite = true
}
lineage {
    enabled = true
}

// Load module configurations
includeConfig 'configs/reprocess10x_sra2fastq.config'
includeConfig 'configs/reprocess10x_bam2fastq.config'
includeConfig 'configs/wget10x.config'
includeConfig 'configs/starsolo10x.config'
includeConfig 'configs/reprocess10x_mappingqc.config'
includeConfig 'configs/fetch10xmeta.config'
includeConfig 'configs/rename10xrun.config'
includeConfig 'configs/rename10xsample.config'
includeConfig 'configs/sra2fastq.config'
includeConfig 'configs/cellranger.config'

// Capture exit codes from upstream processes when piping
process.shell = ['/bin/bash', '-euo', 'pipefail']

manifest {
    name            = 'cellgeni/nf-reprocessing-public-10x'
    author          = "CellgenI Team"
    homePage        = 'https://github.com/cellgeni/nf-reprocessing-public-10x'
    description     = "Pipeline to load and process public 10x datasets"
    mainScript      = 'main.nf'
    nextflowVersion = '!>=26.04.6'
    version         = '26-257'
    license         = 'GPL-3.0'
}

outputDir = params.outdir