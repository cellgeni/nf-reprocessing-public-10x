// Configuration applied on top of the pipeline's own nextflow.config when
// running nf-test. It exists to undo the two things the production config does
// that make no sense for a test run: submitting everything to LSF, and ignoring
// failures after five retries.

nextflow.enable.moduleBinaries = true

params {
    publish_dir_mode = "copy"
    outdir           = "results"
}

process {
    // a failing test must fail loudly and immediately; the production config
    // retries five times and then ignores the error, which would turn a broken
    // process into an empty-output pass
    errorStrategy = 'terminate'
    maxRetries    = 0
    cpus          = 1
    memory        = '4.GB'
    time          = '1.h'
}

profiles {
    // Default. FETCH10XMETA only talks to GEO/SRA/ENA over HTTP, so it runs
    // perfectly well wherever the tests are launched from, as long as that host
    // can reach the outside world (on the farm, that means the head nodes or the
    // 'transfer' queue -- see the 'lsf' profile below).
    local {
        process.executor = 'local'
        executor.cpus    = 4
        executor.memory  = '8.GB'
    }

    // Run the tests through LSF the way the pipeline itself does. The 'transfer'
    // queue is the one with outbound network access.
    lsf {
        process.executor = 'lsf'
        process.queue    = 'transfer'
        executor.name           = 'lsf'
        executor.perJobMemLimit = true
    }
}

cleanup = false
