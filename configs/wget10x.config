process {
    withName: '.*WGET10X' {
        // --tries only covers network-level errors; wget treats an HTTP 403 or 503
        // as a hard failure and gives up immediately. ENA throttles with 403, which
        // cost a whole GEO series in the Aug 2026 run even though the files were
        // fine — --retry-on-http-error is what makes those recoverable.
        // The backoff lives inside the job, not in errorStrategy: a closure that
        // sleeps there blocks a Nextflow head-node thread, and with 20 of these in
        // flight that stalls the executor. wget's own --waitretry does the waiting
        // on the cluster instead.
        //
        // --continue is added by the module, not here, and deliberately: it must
        // apply to the in-job resume loop but NOT to the clean refetch that follows
        // a failed integrity check. Keeping it out of ext.args is what keeps those
        // two calls distinguishable. This reverses the earlier decision to omit
        // resuming altogether — that policy cost two samples in batch 2, where 33 GB
        // files restarted from byte zero on all five Nextflow attempts and never
        // finished. Resuming is safe here only because the archive is integrity
        // tested afterwards and refetched whole if the splice was bad.
        //
        // --read-timeout is 300 rather than 60 because ENA stalls for minutes and
        // then recovers; a 60 s ceiling turned recoverable stalls into aborted reads.
        // -nv drops wget's progress bar, which wrote roughly 700,000 dot-lines for a
        // single 33 GB transfer and was most of the 9.9 M lines in batch 2's failure
        // log. Errors and the final "saved" line are still printed.
        ext.args   = "--no-verbose --retry-connrefused --read-timeout=300 --timeout=60 --tries=10 --waitretry=60 --retry-on-http-error=403,429,500,502,503,504"
        ext.verify_downloads = true
        // In-job resume attempts before the task gives up. Six attempts with a
        // 20s, 40s, … 100s pause between them covers the observed ENA outage
        // lengths while staying well inside the transfer queue's runtime limit.
        ext.dl_tries = 6
        array      = 20
        maxForks   = 20
        queue      = 'transfer'
        memory     = { 4.GB + 4.GB * (task.attempt - 1) }
        cpus       = 1
        errorStrategy = { task.attempt == 5 ? 'ignore' : 'retry' }
        maxRetries    = 5
        // publishDir = [
        //     path: { "${params.outdir}/raw/${meta.dataset_id}/" },
        //     mode: params.publish_mode,
        //     saveAs: { filepath ->
        //         if ( filepath ==~ /.*fastq\.gz/ ) {
        //             return "fastq/${meta.sample_id}/$filepath"
        //         } else if ( filepath ==~ /.*\.bam/ ) {
        //             return "bam/${meta.sample_id}/$filepath"
        //         } else if ( filepath != "versions.yml" ) {
        //             return "sra/${meta.sample_id}/$filepath"
        //         } else {
        //             return null
        //         }
        //     }
        // ]
    }
}