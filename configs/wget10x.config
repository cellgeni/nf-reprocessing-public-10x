process {
    withName: '.*WGET10X' {
        // --tries only covers network-level errors; wget treats an HTTP 403 or 503
        // as a hard failure and gives up immediately. ENA throttles with 403, which
        // cost a whole GEO series in the Aug 2026 run even though the files were
        // fine — --retry-on-http-error is what makes those recoverable.
        // The backoff lives inside the job, not in errorStrategy: a closure that
        // sleeps there blocks a Nextflow head-node thread, and with 20 of these in
        // flight that stalls the executor. wget's own --waitretry does the waiting
        // on the cluster instead. --continue is deliberately absent so a retry
        // always fetches a whole file rather than resuming a possibly corrupt one.
        ext.args   = "--retry-connrefused --read-timeout=60 --timeout=60 --tries=10 --waitretry=60 --retry-on-http-error=403,429,500,502,503,504"
        ext.verify_downloads = true
        array      = 20
        maxForks   = 20
        queue      = 'transfer'
        memory     = { 4.GB + 4.GB * (task.attempt - 1) }
        cpus       = 1
        errorStrategy = { task.attempt == 5 ? 'ignore' : 'retry' }
        maxRetries    = 5
        // publishDir = [
        //     path: { "${params.outdir}/raw/${meta.dataset_id}/" },
        //     mode: params.publish_mode,
        //     saveAs: { filepath ->
        //         if ( filepath ==~ /.*fastq\.gz/ ) {
        //             return "fastq/${meta.sample_id}/$filepath"
        //         } else if ( filepath ==~ /.*\.bam/ ) {
        //             return "bam/${meta.sample_id}/$filepath"
        //         } else if ( filepath != "versions.yml" ) {
        //             return "sra/${meta.sample_id}/$filepath"
        //         } else {
        //             return null
        //         }
        //     }
        // ]
    }
}