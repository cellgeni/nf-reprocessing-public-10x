process {
    withName: '.*REPROCESS10X_SRAFIX' {
        // One vdb-dump | awk | gzip pipeline per cpu over a slice of the spots. SRR8816324
        // (325 M spots, 32 GB .sra): 14.5 min, 9.7 GB peak. Throughput is ~22 M spots/min.
        cpus   = 16
        memory = { 16.GB * task.attempt }
        time   = { 6.h * task.attempt }
        // normal refuses a run limit over 12 h at submission, so a third attempt goes to long
        queue  = { task.time > 12.h ? 'long' : 'normal' }
    }
}
