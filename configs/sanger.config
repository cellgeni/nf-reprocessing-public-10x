// The Sanger farm (farm22): LSF, the group's Singularity cache and binds, the farm's
// references, and queues. Loaded with `-profile sanger`, alone or as
// `-profile sanger,lineage_keep`. Self-contained: it enables Singularity itself.
//
// Written like an nf-core institutional profile (nf-core/configs conf/sanger/farm22.config):
// the queue follows from each task's resolved memory and time, never from its name, so a
// new process needs a label and no queue line here.

params {
    wl_basedir           = "/nfs/cellgeni/STAR/whitelists"
    star_human_reference = "/nfs/cellgeni/STAR/human/2020A/index"
    star_mouse_reference = "/nfs/cellgeni/STAR/mouse/2020A/index"
    cr_human_reference   = "/software/cellgen/cellgeni/refdata_10x/refdata-cellranger-arc-GRCh38-2020-A-2.0.0"
    cr_mouse_reference   = "/software/cellgen/cellgeni/refdata_10x/refdata-cellranger-arc-mm10-2020-A-2.0.0"
}

executor {
    name           = 'lsf'
    perJobMemLimit = true
}

singularity {
    enabled     = true
    autoMounts  = true
    cacheDir    = '/nfs/cellgeni/singularity/images/'
    runOptions  = '-B /lustre,/nfs'
    pullTimeout = '100m'
}

process {
    // Run limits: normal 12 h, long 48 h, week 7 d, basement and hugemem 30 d. normal,
    // long, week and basement refuse any -M above their 683.5 G hard MEMLIMIT at submission
    // ("Cannot exceed queue's hard limit(s). Job not submitted."), so a bigger request goes
    // to hugemem (3.8 T, huge_hosts, open to all). The 2026-10-16 velocyto re-run lost
    // GSM7744878 and SRS4415504 to that refusal, on both attempts. nf-core's farm22 profile
    // cuts at 350 GB, which would send work to hugemem that normal and long take.
    //
    // Only `normal` backfills, and only a job whose explicit run limit lets it finish before
    // a reservation; that is why STARsolo's time is predicted per sample
    // (lib/StarsoloResources.groovy) rather than fixed at 48 h. Its plan() still returns a
    // per-attempt `queue`, which nothing reads any more; it is kept because dropping it
    // would change meta.resources, and every STARsolo task hash with it.
    queue = {
        task.memory > 683.GB ? 'hugemem'
            : task.time > 7.d  ? 'basement'
            : task.time > 2.d  ? 'week'
            : task.time > 12.h ? 'long'
            : 'normal'
    }

    // `transfer` is for data transfer jobs and caps a user at 40 concurrent, which is what
    // WGET10X's maxForks matches. `normal` has outbound network too, but is for compute.
    withLabel: 'process_network' {
        queue = 'transfer'
    }

    // Submitted as LSF job arrays of 10. The local executor cannot run arrays at all, which
    // is why this lives here and not in configs/wget10x.config.
    withName: '.*WGET10X' {
        array = 10
    }
}
