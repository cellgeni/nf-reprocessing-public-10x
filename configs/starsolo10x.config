process {
    withName: '.*STARSOLO10X.*' {
        ext.args = "--no-bam -- --limitOutSJcollapsed 10000000"
        cpus = 16
        // Memory, run limit and queue per attempt come from meta.resources, set in
        // subworkflows/local/starsolo10x from the sample's estimated read count
        // (lib/StarsoloResources.groovy; constants fitted in
        // notebooks/resource_prediction.ipynb). They replace the fixed 128/256/384 GB
        // ladder on `long`, which every sample above ~1.2e9 reads failed once. When the
        // estimate failed meta.resources is null and the old ladder applies.
        memory = { meta.resources ? "${meta.resources.mem_gb[task.attempt - 1]} GB" : 128.GB * task.attempt }
        time   = { meta.resources ? "${meta.resources.hours[task.attempt - 1]}h" : 48.h }
        // `normal` and `long` refuse any -M above their 683.5 G hard MEMLIMIT at submission
        // ("Cannot exceed queue's hard limit(s). Job not submitted."), and plan() caps memory at
        // 1024 GB, so a bigger request goes to `hugemem` (3.8 T, huge_hosts, open to all). The
        // 2026-10-16 velocyto re-run lost GSM7744878 and SRS4415504 this way, on both attempts.
        // Decided here rather than in StarsoloResources so that meta.resources, and with it
        // every STARsolo task hash, is unchanged: a -resume does not re-run anything for it.
        queue  = { task.memory > 683.GB ? 'hugemem' : (meta.resources ? meta.resources.queue[task.attempt - 1] : 'long') }
        maxRetries    = 5
        // publishDir = [
        //     path: { "${params.outdir}/starsolo/${meta.dataset_id}/" },
        //     mode: params.publish_mode,
        //     saveAs: { filename -> filename == 'versions.yml' ? null : filename  }  // Do not publish versions.yml
        // ]
    }
}
