process {
    withName: '.*REPROCESS10X_SRACHECK' {
        // vdb-dump --info and fastq-dump over five 10,000-spot windows: 40 s and ~100 MB on a
        // healthy run (SRR8816321). On a GenericFastq run vdb-dump --info alone took 6.5 min and
        // 8.4 GB (SRR8816324), and 4 GB was killed at TERM_MEMLIMIT, hence the headroom.
        queue  = 'normal'
        cpus   = 1
        memory = { 16.GB * task.attempt }
        time   = 1.h
    }
}
