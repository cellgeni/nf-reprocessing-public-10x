// Resources by label, the nf-core way: a module says how big it is (`label 'process_*'`),
// this file says what that means, and a site profile picks the queue from the resulting
// cpus/memory/time (configs/sanger.config on the farm). Nothing here names an executor or
// a queue. The per-process files in configs/ hold only what a label cannot say.
//
// Times are the run limit of the queue each process used before it had a label (normal
// 12 h, long 48 h), so -profile sanger routes every task exactly where it went before.
// They are loose on purpose; tightening them from the traces is a separate change, and
// would move some work to `normal`, which backfills. Longest COMPLETED realtime over
// batches 20-26: RENAME10XRUN 11.9 h, WGET10X 6.9 h, SRA2FASTQ 4.0 h, STARsolo 19.5 h.
process {
    cpus   = 1
    memory = { 4.GB * task.attempt }
    time   = 12.h

    withLabel: 'process_single' {
        cpus   = 1
        memory = { 4.GB * task.attempt }
    }
    withLabel: 'process_high' {
        cpus   = 16
        memory = { 64.GB * task.attempt }
    }
    // After process_high: of two matching labels, the later one wins.
    withLabel: 'process_long' {
        time   = 48.h
    }
    // Needs outbound HTTP (GEO, SRA, ENA, BioStudies). It sets no resources; it is there
    // for a site profile to route on, as sanger.config sends it to `transfer`.
    withLabel: 'process_network' {
    }
}
