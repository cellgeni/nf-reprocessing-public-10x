// Work-dir cleanup that keeps failed lineages: plugins/nf-lineage-keep.
//
// Loaded only through `-profile lineage_keep`. A plugin listed in the main
// `plugins {}` block would be fetched from the Nextflow registry by anyone who
// has not installed it locally, and this one is not in the registry; the
// `lineageKeep` scope would also be an unknown config option without it.
// Install first: `cd plugins/nf-lineage-keep && make install` (see its README).
//
// Outputs go to <outdir>/cleanup/: deleted.tsv (every directory cleaned, with
// apparent and actually-freed bytes), processes.tsv (who reads each output),
// failed_tasks.tsv, and rerun.tsv, an input table for --datasets holding only
// the failed samples. Re-run it with -resume on the same work dir: everything
// upstream of each failure was kept, so those tasks come back CACHED.
plugins {
    id 'nf-lineage-keep@0.1.0'
}

lineageKeep {
    enabled  = true
    // Logs what it would delete and touches nothing. Set to false once a
    // dry-run batch has been checked against sample_failures.py.
    dryRun   = true
    keepLogs = true

    // Run once at the end over everything: what they read is held until they
    // end, but their success is not needed for a sample to count as done, and
    // their failure keeps nothing.
    barrierProcesses = ['REPROCESS10X_COLLATE', 'REPROCESS10X_RUNREPORT']

    // Each upstream file is read by exactly one task of these. The STARsolo
    // pattern is one group covering both species aliases; Cell Ranger's are kept
    // apart on purpose, since with --cellranger and --starsolo both read the
    // same renamed FASTQs.
    singleUseProcesses = [
        'RENAME10XRUN',
        'RENAME10XSAMPLE',
        'SRA2FASTQ',
        'REPROCESS10X_SRACHECK',
        'REPROCESS10X_SRAFIX',
        'REPROCESS10X_BAM2FASTQ',
        'REPROCESS10X_STARSOLO10X',
        'CELLRANGER_COUNT_HUMAN',
        'CELLRANGER_COUNT_MOUSE',
        'REPROCESS10X_MAPPINGQC',
    ]

    // STAR leaves _STARtmp behind when it dies: 32 TB of it in batch 24's
    // killed tasks, 16.7 TB in its re-run's failures. It is never needed to
    // debug or to re-run, so it goes whatever the outcome.
    scratch = ['REPROCESS10X_STARSOLO10X:{_STARtmp,**/_STARtmp}']

    // Re-run keys: run-level meta carries sample_id and dataset_id, sample-level
    // meta carries dataset_id with the sample in id, FETCH10XMETA and MAPPINGQC
    // carry the dataset in id. FETCH10XMETA's sample subset is its sample_ids input.
    metaVariable       = 'meta'
    datasetKey         = 'dataset_id'
    sampleKey          = 'sample_id'
    idKey              = 'id'
    sampleListVariable = 'sample_ids'
}
