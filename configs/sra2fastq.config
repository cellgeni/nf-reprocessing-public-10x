process {
    withName: '.*SRA2FASTQ' {
        queue = 'long'
        cpus = 16
        // Across ~29,600 attempts in batches 1-24, peak RSS was 4.1 GB median and 5.6 GB p99, and
        // only two runs ever went past 8 GB: SRR25376447 (96.3 GB, batch 18) and SRR8816330
        // (65.2 GB, batch 24). So the first attempt asks for 16 GB and any retry for the 128 GB
        // every attempt used to get, which covers both. Retries do not escalate past that: the
        // 192-384 GB requests of the old ladder all went to tasks failing deterministically at
        // exit 1 (mates disagree, one FASTQ produced), which more memory never fixed.
        // Per-run prediction was tried and is not worth it (notebooks/resource_prediction.ipynb
        // §11): with 16 cpus the peak plateaus at ~5.5-6.5 GB whatever the .sra size, and the two
        // outliers are not explained by size, spots, read length or platform.
        memory     = { task.attempt == 1 ? 16.GB : 128.GB }
        errorStrategy = { task.attempt == 5 ? 'ignore' : 'retry' }
        maxRetries    = 5
    }
}
