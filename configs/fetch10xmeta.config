process {
    withName: '.*FETCH10XMETA' {
        queue      = 'transfer'
        maxForks   = 7
        cpus       = 1
        memory     = { 4.GB + 2.GB * (task.attempt - 1) }
        errorStrategy = { task.attempt == 5 ? 'ignore' : 'retry' }
        maxRetries    = 5
        // publishDir = [
        //     path  : { "${params.outdir}/metadata/${meta.id}" },
        //     mode  : params.publish_mode,
        //     saveAs: { filename -> filename == 'versions.yml' ? null : filename  }  // Do not publish versions.yml
        // ]
    }
}