plugins {
    id 'nf-lineage-keep@0.2.0'
}

params {
    datasets = 'datasets.tsv'
    outdir   = 'results'
    fail     = 'S3'      // the sample whose ALIGN fails for good
    flaky    = 'S1a,S3a' // runs whose DOWNLOAD fails once, in an OK chain and in S3's
}

workDir   = 'work'
outputDir = params.outdir

process.executor = 'local'

workflow {
    output {
        mode = 'link'
    }
}

trace {
    enabled   = true
    file      = "${params.outdir}/trace.txt"
    overwrite = true
    fields    = 'task_id,hash,process,tag,name,status,exit,attempt,workdir'
}

lineageKeep {
    enabled              = true
    dryRun               = false
    interval             = '2s'
    barrierProcesses     = ['COLLATE', 'REPORT']
    singleUseProcesses   = ['RENAME_RUN', 'RENAME_SAMPLE', 'ALIGN', 'QC']
    scratch              = ['ALIGN:{_STARtmp,**/_STARtmp}']
    cleanRetriedAttempts = true
    cleanFailedTasks     = true
    failedKeepBelow      = '1 MB'
}
