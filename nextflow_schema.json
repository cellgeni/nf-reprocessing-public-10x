{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://raw.githubusercontent.com/cellgeni/nf-reprocessing-public-10x/main/nextflow_schema.json",
    "title": "cellgeni/nf-reprocessing-public-10x parameters",
    "description": "Load and reprocess public 10x datasets from GEO, SRA, ENA or ArrayExpress",
    "type": "object",
    "$defs": {
        "input_output_options": {
            "title": "Input/output options",
            "type": "object",
            "fa_icon": "fas fa-terminal",
            "required": ["datasets"],
            "properties": {
                "datasets": {
                    "type": "string",
                    "format": "file-path",
                    "exists": true,
                    "description": "Tab-separated table of dataset_id and sample_id, whatever its extension.",
                    "help_text": "Columns `dataset_id` and `sample_id`; `sample_id` holds comma-separated accessions. Leaving it empty processes the WHOLE series, which is intentional, but a series is often mixed: run with `--metaonly` first to see what it holds.",
                    "fa_icon": "fas fa-file-csv"
                },
                "outdir": {
                    "type": "string",
                    "format": "directory-path",
                    "default": "results",
                    "description": "Directory to save results.",
                    "fa_icon": "fas fa-folder-open"
                },
                "publish_mode": {
                    "type": "string",
                    "default": "link",
                    "enum": ["symlink", "rellink", "link", "copy", "copyNoFollow", "move"],
                    "description": "How published files are written into --outdir.",
                    "fa_icon": "fas fa-copy"
                }
            }
        },
        "run_options": {
            "title": "Run options",
            "type": "object",
            "fa_icon": "fas fa-play",
            "properties": {
                "metaonly": {
                    "type": "boolean",
                    "default": false,
                    "description": "Only fetch metadata; skip downloading and alignment.",
                    "fa_icon": "fas fa-info"
                },
                "starsolo": {
                    "type": "boolean",
                    "default": false,
                    "description": "Align with STARsolo after downloading.",
                    "fa_icon": "fas fa-star"
                },
                "cellranger": {
                    "type": "boolean",
                    "default": false,
                    "description": "Align with Cell Ranger after downloading.",
                    "fa_icon": "fas fa-dna"
                },
                "no_raw": {
                    "type": "boolean",
                    "default": false,
                    "description": "Publish nothing under raw/ (downloaded BAM/SRA/FASTQ, per-run and renamed FASTQs) nor their index CSVs.",
                    "help_text": "The files then exist only in the work directory. Pair it with `-profile lineage_keep` to have them deleted as each sample finishes, while a failed sample's stay for its -resume.",
                    "fa_icon": "fas fa-ban"
                }
            }
        },
        "species_options": {
            "title": "Species options",
            "type": "object",
            "fa_icon": "fas fa-paw",
            "properties": {
                "default_specie": {
                    "type": "string",
                    "enum": ["human", "mouse"],
                    "description": "Species for samples whose metadata is missing or contradictory.",
                    "help_text": "If unset, such samples are skipped with a warning and listed in skipped_samples.tsv.",
                    "fa_icon": "fas fa-paw"
                },
                "no_infer_specie": {
                    "type": "boolean",
                    "default": false,
                    "description": "Ignore species in the metadata and assign --default_specie to every sample. Requires --default_specie.",
                    "fa_icon": "fas fa-ban"
                }
            }
        },
        "reference_options": {
            "title": "Reference options",
            "type": "object",
            "fa_icon": "fas fa-book",
            "properties": {
                "wl_basedir": {
                    "type": "string",
                    "format": "directory-path",
                    "exists": true,
                    "default": "/nfs/cellgeni/STAR/whitelists",
                    "description": "Directory of 10x barcode whitelists.",
                    "fa_icon": "fas fa-list"
                },
                "star_human_reference": {
                    "type": "string",
                    "format": "directory-path",
                    "default": "/nfs/cellgeni/STAR/human/2020A/index",
                    "description": "STAR index for human samples.",
                    "fa_icon": "fas fa-book"
                },
                "star_mouse_reference": {
                    "type": "string",
                    "format": "directory-path",
                    "default": "/nfs/cellgeni/STAR/mouse/2020A/index",
                    "description": "STAR index for mouse samples.",
                    "fa_icon": "fas fa-book"
                },
                "cr_human_reference": {
                    "type": "string",
                    "format": "directory-path",
                    "default": "/software/cellgen/cellgeni/refdata_10x/refdata-cellranger-arc-GRCh38-2020-A-2.0.0",
                    "description": "Cell Ranger reference for human samples.",
                    "fa_icon": "fas fa-book"
                },
                "cr_mouse_reference": {
                    "type": "string",
                    "format": "directory-path",
                    "default": "/software/cellgen/cellgeni/refdata_10x/refdata-cellranger-arc-mm10-2020-A-2.0.0",
                    "description": "Cell Ranger reference for mouse samples.",
                    "fa_icon": "fas fa-book"
                }
            }
        },
        "generic_options": {
            "title": "Generic options",
            "type": "object",
            "fa_icon": "fas fa-file-import",
            "properties": {
                "help": {
                    "type": "boolean",
                    "default": false,
                    "description": "Show this help message and exit.",
                    "fa_icon": "fas fa-question-circle",
                    "hidden": true
                },
                "monochrome_logs": {
                    "type": "boolean",
                    "default": false,
                    "description": "Do not use coloured log output.",
                    "fa_icon": "fas fa-palette",
                    "hidden": true
                },
                "trace_report_suffix": {
                    "type": "string",
                    "description": "Suffix of the trace, report and DAG file names; defaults to the launch timestamp.",
                    "fa_icon": "fas fa-clock",
                    "hidden": true
                }
            }
        }
    },
    "allOf": [
        { "$ref": "#/$defs/input_output_options" },
        { "$ref": "#/$defs/run_options" },
        { "$ref": "#/$defs/species_options" },
        { "$ref": "#/$defs/reference_options" },
        { "$ref": "#/$defs/generic_options" }
    ]
}
